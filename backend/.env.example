# ==============================================================================
# REAPER — Autonomous Software Repair Engine
# Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL / Supabase / SQLite for local development)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reaper_db
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./reaper.db

# JWT Authentication
JWT_SECRET_KEY=reaper-secret-super-secure-key-2026-argon2-sha256-jwt-cipher-lead-architect-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Cache & Celery Task Broker
REDIS_URL=redis://localhost:6379/0

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@reaper.ai
SMTP_TLS=true

# AI Provider Configuration
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=reaper-repair-v2

# GitHub App Integration (Disabled by default for pre-hackathon safe isolation)
ENABLE_GITHUB_INTEGRATION=false
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Client Application
FRONTEND_ORIGIN=http://localhost:5173

# Docker Sandbox Settings
ENABLE_DOCKER_SANDBOX=false
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU=1.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
