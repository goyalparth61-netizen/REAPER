# ==========================================
# REAPER — Environment Configuration (.env.example)
# ==========================================

# Application
APP_NAME=REAPER
APP_ENV=development
DEBUG=true

# Database Configuration
# Primary: Supabase PostgreSQL (use port 6543 or 5432 with pooler URL for IPv4 compatibility)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# When true, falls back to local SQLite if PostgreSQL is unreachable
USE_SQLITE_FALLBACK=true

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# AI Multi-Agent Configuration
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash

# Agent Toggles
ENABLE_DETECTION_AGENT=true
ENABLE_DIAGNOSIS_AGENT=true
ENABLE_REPAIR_AGENT=true
ENABLE_VERIFICATION_AGENT=true

# JWT Authentication
JWT_SECRET_KEY=your-secure-random-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Sandboxing
ENABLE_DOCKER_SANDBOX=true
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU=1.0

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# Optional Integrations
REDIS_URL=redis://localhost:6379/0
ENABLE_GITHUB_INTEGRATION=false
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@reaper.ai
SMTP_TLS=true
